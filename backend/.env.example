# ──────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# SQLite is used as the database engine — no external server (MySQL, Postgres,
# Laragon, etc.) is required. The database is a single portable .db file.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  LOCAL DEVELOPMENT                                                      │
# │  Creates backend/portfolio.db relative to the server's working dir.    │
# └─────────────────────────────────────────────────────────────────────────┘
DATABASE_URL=sqlite:///./portfolio.db

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  CLOUD DEPLOYMENT — Persistent Volume Mount                            │
# │                                                                         │
# │  Platforms like Render, Railway, and FastAPI Cloud allow you to attach │
# │  a persistent disk / volume. Set DATABASE_URL to the absolute path of  │
# │  the volume mount point so the .db file survives container restarts.   │
# │                                                                         │
# │  Render persistent disk (mount path: /data):                           │
# │    DATABASE_URL=sqlite:////data/portfolio.db                           │
# │                                                                         │
# │  Railway volume (mount path: /mnt/data):                              │
# │    DATABASE_URL=sqlite:////mnt/data/portfolio.db                       │
# │                                                                         │
# │  NOTE: Four slashes (////) = three for SQLite protocol + one for the   │
# │  absolute path starting with /.                                         │
# └─────────────────────────────────────────────────────────────────────────┘
# DATABASE_URL=sqlite:////data/portfolio.db

# ──────────────────────────────────────────────────────────────────────────────
# SECURITY & JWT
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──────────────────────────────────────────────────────────────────────────────
# CORS — Allowed Origins
# ──────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-vercel-app.vercel.app

# ──────────────────────────────────────────────────────────────────────────────
# ADMIN SEED ACCOUNT
# Only used ONCE on first startup when the users table is completely empty.
# Changing these values after the admin is created has NO effect unless you
# delete the database file and restart.
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=muneer
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_EMAIL=your-email@example.com